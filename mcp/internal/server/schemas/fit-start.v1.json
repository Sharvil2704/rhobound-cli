{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Sharvil2704/rhobound-cli/main/docs/mcp/schemas/fit-start.v1.json",
  "title": "rhobound-mcp fit_start",
  "description": "The `fit_start` tool (ARCHITECTURE.md 5.5): a fresh fit, or an A/B difference, as a job. Server only: it has no CLI twin of the same shape (the job runs `rhobound check` and `rhobound fit`, or `rhobound diff-fit`). Capture names map to locations in server configuration; a tool argument never carries a bucket, a prefix or a path, and on AWS the top-level capture argument is refused. The root validates the output; $defs/input is the input schema.",
  "$ref": "#/$defs/output",
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "env": {"$ref": "defs.v1.json#/$defs/Env"},
        "capture": {"$ref": "defs.v1.json#/$defs/Name", "description": "stdio only: a capture name from the user's config file"},
        "window": {"type": "object", "properties": {
          "end": {"type": "string", "description": "RFC 3339 UTC, or 'latest'"},
          "minutes": {"type": "integer", "minimum": 2, "maximum": 30}},
          "additionalProperties": false},
        "ab": {"type": "object", "properties": {
          "baseline": {"$ref": "defs.v1.json#/$defs/Name", "description": "a registered capture name"},
          "candidate": {"$ref": "defs.v1.json#/$defs/Name"}},
          "required": ["baseline", "candidate"],
          "additionalProperties": false},
        "workers": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}
      },
      "oneOf": [{"required": ["env"]}, {"required": ["capture"]}, {"required": ["ab"]}],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "job_id": {"$ref": "defs.v1.json#/$defs/Handle"},
        "state": {"const": "working"},
        "poll_after_ms": {"type": "integer"},
        "deadline_at": {"type": "string"},
        "estimated_s": {"type": "integer"}
      },
      "required": ["job_id", "state", "poll_after_ms", "deadline_at"],
      "additionalProperties": false
    }
  }
}
