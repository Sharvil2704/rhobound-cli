{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Sharvil2704/rhobound-cli/main/docs/mcp/schemas/request-count.v1.json",
  "title": "rhobound.request-count/v1",
  "description": "An independent count of entry requests for the capture's window (DATA.md 6), from a source outside the trace pipeline. Refused: count.window_mismatch (window edges more than 10 s from the capture's), count.unknown_entry. appsignals is accepted only as unverified.",
  "type": "object",
  "properties": {
    "schema": {"const": "rhobound.request-count/v1"},
    "window": {
      "type": "object",
      "properties": {
        "start": {"$ref": "defs.v1.json#/$defs/Time"},
        "end": {"$ref": "defs.v1.json#/$defs/Time"}
      },
      "required": ["start", "end"],
      "additionalProperties": false
    },
    "source": {"enum": ["alb", "apigw", "ingress", "loadgen", "appsignals"]},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "entry": {"type": "string", "minLength": 1},
          "count": {"type": "integer", "minimum": 0}
        },
        "required": ["entry", "count"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema", "window", "source", "entries"],
  "additionalProperties": false
}
