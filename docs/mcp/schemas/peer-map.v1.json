{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Sharvil2704/rhobound-cli/main/docs/mcp/schemas/peer-map.v1.json",
  "title": "rhobound.peer-map/v1",
  "description": "The ECS peer map, CAPTURE/peer-map.json (DATA.md 5): CLIENT peers given as an address or a DNS name, mapped to the service that answers there (trace.peer_renamed). A file that does not match this schema is refused with cluster.peer_map_invalid.",
  "type": "object",
  "properties": {
    "schema": {"const": "rhobound.peer-map/v1"},
    "taken_at": {"$ref": "defs.v1.json#/$defs/Time"},
    "addresses": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1},
                  "description": "<ip:port or DNS name> -> <service.name>"},
    "desired_count": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "instance_type": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "required": ["schema", "addresses"],
  "additionalProperties": false
}
