        W["kms_calls"] += 1
        for s in pol["Statement"]:
            for p in ([s["Principal"]["AWS"]] if isinstance(s["Principal"]["AWS"], str) else s["Principal"]["AWS"]):
                m = re.fullmatch(r"arn:aws:iam::\d{12}:role/(.+)", p)
                if m and (m.group(1) not in W["roles"] or W["kms_calls"] <= int(os.environ.get("FAKE_KMS_LAG", "0"))):
                    fail("MalformedPolicyDocumentException", "Policy contains a statement with one or more invalid principals.", opname())
        return pol

