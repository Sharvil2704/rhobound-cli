        done()
    if op == "schedule-key-deletion":
        k = resolve(opt("--key-id")); d = int(opt("--pending-window-in-days", "30"))
        if not 7 <= d <= 30:
            fail("ValidationException", "PendingWindowInDays must be 7..30", "ScheduleKeyDeletion")
        if W["keys"][k]["state"] == "PendingDeletion":
            fail("KMSInvalidStateException", "already pending deletion", "ScheduleKeyDeletion")
        W["keys"][k]["state"] = "PendingDeletion"; W["keys"][k]["window"] = d; done({"KeyId": k, "PendingWindowInDays": d})
    if op == "cancel-key-deletion":
        k = resolve(opt("--key-id")); W["keys"][k]["state"] = "Disabled"; done()
    if op == "enable-key":
