#!/usr/bin/env bash
# Fake kubectl for test_ab.sh: records every call in $FAKE_T/kubectl.log and answers from canned files.
# FAKE_PROD (Deployment JSON), FAKE_ROLLOUT_RC, FAKE_EXEC_NEVER=1 (the driver never finishes), $FAKE_T/driver-out/.
set -uo pipefail
T=${FAKE_T:?}
printf '%s\n' "$*" >>"$T/kubectl.log"
all="$*"
rest=()
while (($#)); do
  case $1 in
    -n) shift 2 ;;
    *) rest+=("$1"); shift ;;
  esac
done
set -- "${rest[@]}"
case ${1:-} in
  get)
    [[ ${2:-} == deployment && ${4:-} == -o && ${5:-} == json ]] || { echo "fake kubectl: get $*" >&2; exit 1; }
    cat "${FAKE_PROD:?}" ;;
  apply)
    [[ ${2:-} == -f && -f ${3:-} ]] || { echo "fake kubectl: apply needs -f FILE" >&2; exit 1; }
    mkdir -p "$T/applied"
    n=$(find "$T/applied" -name '*.json' | wc -l)
    cp "$3" "$T/applied/$n.json"
    jq -r '.items[] | "\(.kind | ascii_downcase)/\(.metadata.name) created"' "$3" ;;
  rollout) exit "${FAKE_ROLLOUT_RC:-0}" ;;
  wait) exit 0 ;;
  delete) echo "deleted (fake)" ;;
  exec)
    [[ ${FAKE_EXEC_NEVER:-0} == 1 ]] && exit 1
    n=$(grep -c ' exec ' "$T/kubectl.log")
    (( n >= ${FAKE_EXEC_AFTER:-2} )) || exit 1     # the first polls: not finished yet
    cat "$T/driver-out/exit" ;;
  cp)
    [[ ${2:-} == abdrive:/out && -n ${3:-} && ! -e ${3:-} ]] || { echo "fake kubectl: cp $*" >&2; exit 1; }
    cp -r "$T/driver-out" "$3" ;;
  *) echo "fake kubectl: unexpected call: $all" >&2; exit 1 ;;
esac
