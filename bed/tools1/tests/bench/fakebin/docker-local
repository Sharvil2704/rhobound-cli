#!/usr/bin/env -S python3 -I
"""Test stand-in for docker (t_sbx_go.sh's SBX_DOCKER) that RUNS the container's script on this box with the local Go,
inside capped.sh (RB_MEM_MAX=2G, GOMAXPROCS=2): the mounts become host folders by one-pass path rewriting of the script
and the -e values (/w -> the -v source, /out -> its source, /tmp -> LOCAL_TMP). No isolation: only for the kit's own
fixtures. It proves what the docker stand-in cannot: the scratch module's minimal go.mod, GOFLAGS=-mod=mod GOPROXY=off,
the compiled-once interleaved bench and sbx.sh's parser on real 'go test' output. Env: LOCAL_TMP, CAPPED, GO_BIN_DIR.
"""
import os, re, subprocess, sys

argv = sys.argv[1:]
if not argv or argv[0] != "run":
    sys.exit(0 if argv and argv[0] == "rm" else 2)
VAL = {"--name", "--network", "--tmpfs", "--cap-drop", "--security-opt", "--pids-limit", "--memory", "--cpus", "--user", "-e", "-v"}
i, env, host = 1, {}, {"tmp": os.environ["LOCAL_TMP"]}
while i < len(argv) and argv[i].startswith("-"):
    if argv[i] == "-e":
        k, _, v = argv[i + 1].partition("=")
        env[k] = v
    elif argv[i] == "-v":
        h, c = argv[i + 1].split(":")[:2]
        host[c.strip("/")] = h
    i += 2 if argv[i] in VAL else 1
cmd = argv[i + 1:]
mnt = re.compile(r"(?<![\w.])/(w|out|tmp)(?=/|\b)")


def tr(s):
    return mnt.sub(lambda m: host[m.group(1)], s)


env = {k: tr(v) for k, v in env.items()}
os.makedirs(host["tmp"], exist_ok=True)
run_env = {"PATH": os.environ["GO_BIN_DIR"] + ":/usr/bin:/bin", "RB_MEM_MAX": "2G", **env, "GOMAXPROCS": "2",
           "XDG_RUNTIME_DIR": os.environ.get("XDG_RUNTIME_DIR", ""), "DBUS_SESSION_BUS_ADDRESS": os.environ.get("DBUS_SESSION_BUS_ADDRESS", "")}
r = subprocess.run(["bash", os.environ["CAPPED"]] + [tr(c) for c in cmd], env=run_env)
sys.exit(r.returncode)
