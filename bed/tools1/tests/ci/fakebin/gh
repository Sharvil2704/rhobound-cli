#!/usr/bin/env bash
# test stand-in for gh (make_prs.sh): auth status, repo view (STUB_GH_VIS, STUB_GH_SQUASH), pr list (STUB_GH_OPEN_PR),
# pr create (logged), label list (STUB_GH_LABELS, a JSON list; default none) and label create (logged). Never touches the network.
set -euo pipefail
echo "gh $*" >> "$STUB_DIR/calls.log"
case "${1:-} ${2:-}" in
  "auth status") exit 0 ;;
  "repo view") printf '{"visibility":"%s","mergeCommitAllowed":true,"squashMergeAllowed":%s,"rebaseMergeAllowed":false}\n' \
    "${STUB_GH_VIS:-PRIVATE}" "${STUB_GH_SQUASH:-false}" ;;
  "pr list") echo "${STUB_GH_OPEN_PR:-}" ;;
  "pr create") echo "https://github.com/Sharvil2704/rhobound-demo/pull/$((RANDOM % 90 + 10))" ;;
  "label list") echo "${STUB_GH_LABELS:-[]}" ;;
  "label create") exit 0 ;;
  "auth git-credential") exit 0 ;;
  "api user") echo "1234567 rbd-demo-bot" ;;
  *) echo "gh stub: unsupported: $*" >&2; exit 2 ;;
esac
