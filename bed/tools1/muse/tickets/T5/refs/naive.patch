+// BulkQty is the quantity a search result's bulk price is quoted at (pricing's top volume tier).
+const BulkQty = 50
+
+// Hit is one search result with its bulk price.
+type Hit struct {
+	ID        int // the product, as Search returns it
+	BulkCents int // the price of one unit when BulkQty are bought, as pricing charges it
+}
+
+// SearchHits returns Search's results, in Search's order, each with its bulk price: pricing.Quote for a line of
+// BulkQty units of the product, divided by BulkQty and rounded to the nearest cent (half up).
+func SearchHits(terms []string, k int) []Hit {
+	ids := Search(terms, k)
+	hits := make([]Hit, len(ids))
+	for i, id := range ids {
+		hits[i] = Hit{ID: id, BulkCents: bulkCents(id)}
+	}
+	return hits
+}
+
+func bulkCents(id int) int {
+	total := pricing.Quote([]pricing.Line{{Cents: products[id].Price, Qty: BulkQty}})
+	return (total + BulkQty/2) / BulkQty
+}
+
+// appendHits prints hits as [id:cents id:cents ...].
+func appendHits(b []byte, hits []Hit) []byte {
+	b = append(b, '[')
+	for i, h := range hits {
+		if i > 0 {
+			b = append(b, ' ')
+		}
+		b = fmt.Appendf(b, "%d:%d", h.ID, h.BulkCents)
+	}
+	return append(b, ']')
+}
+
