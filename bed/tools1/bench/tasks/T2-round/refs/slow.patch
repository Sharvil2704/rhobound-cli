+// roundHalfEven rounds a non-negative rational to an integer, ties to even.
+func roundHalfEven(x *big.Rat) int64 {
+	num, den := new(big.Int).Set(x.Num()), x.Denom()
+	q, r := new(big.Int).QuoRem(num, den, new(big.Int))
+	twice := new(big.Int).Mul(r, big.NewInt(2))
+	switch c := twice.Cmp(den); {
+	case c > 0, c == 0 && q.Bit(0) == 1:
+		q.Add(q, big.NewInt(1))
+	}
+	return q.Int64()
+}
