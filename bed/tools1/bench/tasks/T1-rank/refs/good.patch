+// posting: a document (index into the catalog) holding a term, and the term's count there.
+type posting struct {
+	doc int32
+	tf  int32
+}
+
+// The inverted index is built once from the catalog (read-only afterwards, so concurrent Ranks share it).
+var (
+	idxOnce  sync.Once
+	idxPost  map[string][]posting
+	idxDL    []int
+	idxAvgDL float64
+	idxIDs   []int
+)
+
+func buildIndex() {
+	docs := Catalog()
+	idxPost = make(map[string][]posting)
+	idxDL = make([]int, len(docs))
+	idxIDs = make([]int, len(docs))
+	total := 0
+	counts := make(map[string]int32)
+	for i, d := range docs {
+		toks := tokenize(Fold(d.Title))
+		idxDL[i], idxIDs[i] = len(toks), d.ID
+		total += len(toks)
+		clear(counts)
+		for _, t := range toks {
+			counts[t]++
+		}
+		for t, c := range counts { // postings stay in catalog order: documents are visited in order
+			idxPost[t] = append(idxPost[t], posting{int32(i), c})
+		}
+	}
+	idxAvgDL = float64(total) / float64(len(docs))
+}
+
+// per-call scratch: a dense score array and the documents it touched (reset before it goes back)
+type scratch struct {
+	score   []float64
+	touched []int32
+}
+
+var scratchPool = sync.Pool{New: func() any { return &scratch{score: make([]float64, len(idxDL))} }}
+
 // Rank returns the TopK documents that best match q, by a BM25 score, highest first; equal scores in ascending ID
 // order; documents with score 0 (no query term) are never returned, so there may be fewer than TopK hits (none for a
 // query without terms).
