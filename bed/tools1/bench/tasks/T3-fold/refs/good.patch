 package hot
 
-import "strings"
+import (
+	"strings"
+	"unicode"
+	"unicode/utf8"
+)
 
 // Fold is the text normalisation shared by search and pricing: Rank folds the query and every title before it
 // tokenizes them, Quote folds promo codes before it looks them up. A change here changes both services.
 //
-// Today it only lower-cases (strings.ToLower: Unicode simple case mapping, rune by rune).
+// Fold lower-cases (Unicode simple case mapping, rune by rune, as strings.ToLower), and also: full-width ASCII
+// (U+FF01..U+FF5E) becomes ASCII, Latin letters with diacritics (U+00C0..U+017F, those whose canonical decomposition
+// is an ASCII letter plus combining marks) lose them, and combining marks (U+0300..U+036F) are dropped.
 func Fold(s string) string {
-	return strings.ToLower(s)
+	i := 0
+	for i < len(s) && s[i] < utf8.RuneSelf {
+		i++
+	}
+	if i == len(s) {
+		return strings.ToLower(s) // ASCII: unchanged behaviour, and its fast path
+	}
+	var sb strings.Builder
+	sb.Grow(len(s))
+	for _, r := range s {
+		switch {
+		case r >= 0xFF01 && r <= 0xFF5E:
+			r -= 0xFEE0
+		case r >= 0x300 && r <= 0x36F:
+			continue
+		case r >= 0xC0 && r < 0x180:
+			if c := latinBase[r-0xC0]; c != '.' {
+				r = rune(c)
+			}
+		}
+		sb.WriteRune(unicode.ToLower(r))
+	}
+	return sb.String()
 }
+
+// latinBase: the ASCII base letter of U+00C0+i, '.' when the letter has none (Æ Ð Ø Þ ß Đ Ł Œ ...).
+const latinBase = "" +
+	"AAAAAA.CEEEEIIII.NOOOOO..UUUUY..aaaaaa.ceeeeiiii.nooooo..uuuuy.y" +
+	"AaAaAaCcCcCcCcDd..EeEeEeEeEeGgGgGgGgHh..IiIiIiIiI...JjKk.LlLlLl." +
+	"...NnNnNn...OoOoOo..RrRrRrSsSsSsSsTtTt..UuUuUuUuUuUuWwYyYZzZzZz."
