{
 "additionalProperties": false,
 "description": "What a judge returns (ARCHITECTURE.md 7.2), checked by `rhobound judge-check ANSWER.json --packet PACKET.json --json`. The schema is the shape only: judge-check refuses with judge.ms_forbidden (a millisecond figure anywhere in a typed field, an own_ms or glue_ms op included), judge.loosening, judge.packet_mismatch, judge.evidence_unresolved and judge.answer_outside_question. Only decision, reasons[].code, assumptions, expected_ops and measure return to the coding agent; commentary goes to humans, wrapped as untrusted.",
 "properties": {
  "assumptions": {
   "items": {
    "additionalProperties": false,
    "properties": {
     "confidence": {
      "enum": [
       "low",
       "medium",
       "high"
      ]
     },
     "evidence": {
      "items": {
       "maxLength": 100,
       "type": "string"
      },
      "maxItems": 8,
      "type": "array"
     },
     "question": {
      "pattern": "^Q[0-9]{1,3}$",
      "type": "string"
     },
     "range": {
      "additionalProperties": false,
      "properties": {
       "hi": {
        "type": "number"
       },
       "lo": {
        "type": "number"
       }
      },
      "required": [
       "lo",
       "hi"
      ],
      "type": "object"
     }
    },
    "required": [
     "question",
     "range",
     "evidence",
     "confidence"
    ],
    "type": "object"
   },
   "maxItems": 16,
   "type": "array"
  },
  "commentary": {
   "description": "free text for humans only; never parsed into a number",
   "maxLength": 2048,
   "type": "string"
  },
  "decision": {
   "enum": [
    "accept",
    "revise",
    "escalate"
   ]
  },
  "measure": {
   "items": {
    "additionalProperties": false,
    "properties": {
     "kind": {
      "enum": [
       "ab",
       "profile"
      ]
     },
     "service": {
      "pattern": "^[A-Za-z0-9._:/@-]{1,128}$",
      "type": "string"
     },
     "why_code": {
      "pattern": "^[a-z_]{1,40}$",
      "type": "string"
     }
    },
    "required": [
     "service",
     "kind",
     "why_code"
    ],
    "type": "object"
   },
   "maxItems": 8,
   "type": "array"
  },
  "packet": {
   "description": "sha256 of the canonical packet answered",
   "pattern": "^sha256:[0-9a-f]{64}$",
   "type": "string"
  },
  "reasons": {
   "items": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "description": "a reason code, for example over_budget",
      "pattern": "^[a-z_]{1,40}$",
      "type": "string"
     },
     "refs": {
      "description": "paths into the packet, for example prediction.entries[0]",
      "items": {
       "maxLength": 100,
       "type": "string"
      },
      "maxItems": 8,
      "type": "array"
     }
    },
    "required": [
     "refs",
     "code"
    ],
    "type": "object"
   },
   "maxItems": 16,
   "type": "array"
  },
  "schema": {
   "const": "rhobound-mcp.judge-answer/v1"
  },
  "suggestions": {
   "items": {
    "additionalProperties": false,
    "properties": {
     "expected_ops": {
      "items": {
       "additionalProperties": false,
       "description": "a number the caller supplies; always labelled declared. v1 applies own_ms, own_pct, workers and load_scale; the others are refused with change.unsupported_op until the variance patch (cs2) and the structural patch ship",
       "properties": {
        "callee": {
         "pattern": "^[A-Za-z0-9._:/@-]{1,128}$",
         "type": "string"
        },
        "note": {
         "maxLength": 200,
         "type": "string"
        },
        "op": {
         "enum": [
          "own_ms",
          "own_pct",
          "workers",
          "load_scale",
          "glue_ms",
          "cs2",
          "add_call",
          "remove_call",
          "set_p",
          "scale_count",
          "set_async",
          "make_parallel"
         ]
        },
        "service": {
         "pattern": "^[A-Za-z0-9._:/@-]{1,128}$",
         "type": "string"
        },
        "value": {
         "oneOf": [
          {
           "type": "number"
          },
          {
           "additionalProperties": false,
           "properties": {
            "hi": {
             "type": "number"
            },
            "lo": {
             "type": "number"
            }
           },
           "required": [
            "lo",
            "hi"
           ],
           "type": "object"
          }
         ]
        }
       },
       "required": [
        "op",
        "service",
        "value"
       ],
       "type": "object"
      },
      "maxItems": 16,
      "type": "array"
     },
     "rank": {
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "rank",
     "expected_ops"
    ],
    "type": "object"
   },
   "maxItems": 8,
   "type": "array"
  }
 },
 "required": [
  "schema",
  "packet",
  "decision"
 ],
 "title": "rhobound-mcp.judge-answer/v1",
 "type": "object"
}
