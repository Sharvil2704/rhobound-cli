# pins.env: every download and image the kit installs on rbd-tools1, by version and sha256 (looked up 2026-10-30).
# shellcheck shell=bash disable=SC2034
# kubectl = the cluster's k3s minor (v1.36.5+k3s1). sha256: https://dl.k8s.io/release/v1.36.5/bin/linux/amd64/kubectl.sha256
RBD_KUBECTL_VERSION=v1.36.5
RBD_KUBECTL_URL=https://dl.k8s.io/release/v1.36.5/bin/linux/amd64/kubectl
RBD_KUBECTL_SHA256=33bc88a24c3b09cf55bfd59e6ca977881b61fc3f25ab65bc80c65b430248648e
# cosign v2 (SPEC's --tlog-upload=false / --insecure-ignore-tlog=true syntax; v3 changed the bundle defaults).
# sha256: https://github.com/sigstore/cosign/releases/download/v2.6.5/cosign_checksums.txt (= the release asset digest)
RBD_COSIGN_VERSION=v2.6.5
RBD_COSIGN_URL=https://github.com/sigstore/cosign/releases/download/v2.6.5/cosign-linux-amd64
RBD_COSIGN_SHA256=c3b4f5410e608af03a5eb0aaac84a4313d8da131248e08ff1759ac70c79d1644
# GitHub Actions runner, released 2026-10-06; installed with --disableupdate (GitHub queues jobs to it until 30 days after the next release).
# sha256: the release notes of https://github.com/actions/runner/releases/tag/v2.338.0 ("BEGIN SHA linux-x64")
RBD_RUNNER_VERSION=2.338.0
RBD_RUNNER_URL=https://github.com/actions/runner/releases/download/v2.338.0/actions-runner-linux-x64-2.338.0.tar.gz
RBD_RUNNER_SHA256=af4b794c1bc41d73d40535e3fe092a39f9679cd8d965954c2aca25a05ca41d32
# AWS CLI v2 2.37.13 (tag 2026-10-12, github.com/aws/aws-cli). AWS publishes a PGP signature, not a sha256: the sha256 below was
# computed on the authors' workstation on 2026-10-30 from a download whose .sig verified (GOODSIG + VALIDSIG) with the AWS CLI Team key
# awscli-pubkey.asc (from https://docs.aws.amazon.com/cli/latest/userguide/getting-started-install.html; expires 2027-07).
# On the machine: sha256 is the hard check, the signature a second one.
RBD_AWSCLI_VERSION=2.37.13
RBD_AWSCLI_URL=https://awscli.amazonaws.com/awscli-exe-linux-x86_64-2.37.13.zip
RBD_AWSCLI_SHA256=c92fde59827622889d3d38a44e2089a137894ce151a2c658a3988ecde4860caa
RBD_AWSCLI_KEY_FPR=FB5DB77FD5C118B80511ADA8A6310ACC4672475C
# The Collector (contrib 0.162.0, 2026-09-29; k8sattributes extracts container.image.repo_digests), runs as 10001:10001.
# Index digest from registry-1.docker.io (manifest of tag 0.162.0); mirrored into ECR by rbd_bootstrap.sh images.
RBD_OTELCOL_SRC=docker.io/otel/opentelemetry-collector-contrib@sha256:39923a8e431bd1f57be82411999d389fcfe40857492e4365456d97a4c1f74be6
RBD_OTELCOL_TAG=otelcol-contrib-0.162.0
RBD_OTELCOL_UID=10001
# busybox 1.37.0 (spans-reader, the Collector's init container), index digest of tag 1.37.0 on registry-1.docker.io
RBD_BUSYBOX_SRC=docker.io/library/busybox@sha256:a7dbc319b1438115a207e11930dc4bb3e643dcb3ec0bdd694bb36cd8fad289ec
RBD_BUSYBOX_TAG=busybox-1.37.0
# The kit's maze/Dockerfile base: golang:1.26.9-bookworm@sha256:d9c68c2c51161e12fd77e4c6320687c9cd86e1af1e3ad6e6cd63ff970641453c
# (hub.docker.com tag 1.26.9-bookworm, last updated 2026-10-08)
