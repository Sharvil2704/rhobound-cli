-// StockCheck (1.1): unchanged from 1.0.
+// stockReject counters record in-process StockCheck rejections per reason so a
+// later change can export them. They use atomics, so they are safe under
+// concurrent requests, and they are three fixed counters, so memory stays
+// bounded regardless of input cardinality.
+var (
+	stockRejectEmpty   atomic.Uint64
+	stockRejectTooLong atomic.Uint64
+	stockRejectBadChar atomic.Uint64
+)
+
+// StockCheck (1.1) validates the item id: 1 to 64 characters of [A-Za-z0-9_-].
+// Every id accepted before (item != "x") that matches the rule is still
+// accepted ("stock", "reserve", ...); the legacy "x" rejection is kept, so no
+// previously rejected matching id becomes accepted. Rejections increment the
+// per-reason counter (empty, too long, bad character).
 func StockCheck(item string) bool {
+	if len(item) == 0 {
+		stockRejectEmpty.Add(1)
+		return false
+	}
+	if len(item) > 64 {
+		stockRejectTooLong.Add(1)
+		return false
+	}
+	for i := 0; i < len(item); i++ {
+		c := item[i]
+		if (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '_' {
+			continue
+		}
+		stockRejectBadChar.Add(1)
+		return false
+	}
 	return item != "x"
 }
