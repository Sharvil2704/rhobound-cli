+// Package audit is part of the shared kshop library 1.1.1 (security hardening): every call that touches a
+// customer-visible decision is sealed with an iterated SHA-256 chain over the call's input, so that a later audit can
+// recompute and compare it. The seal costs CPU in proportion to rounds; nothing reads it back in this process.
+package audit
+
+import (
+	"crypto/sha256"
+	"sync/atomic"
+)
+
+// last keeps the latest seal (one 64-bit word of it) so the work is never optimized away; it is safe under
+// concurrent callers.
+var last atomic.Uint64
+
+// Seal hashes tag through rounds iterations of SHA-256 and records the result.
+func Seal(tag string, rounds int) {
+	h := sha256.Sum256([]byte("kshop-audit-v1:" + tag))
+	for i := 1; i < rounds; i++ {
+		h = sha256.Sum256(h[:])
+	}
+	last.Store(uint64(h[0]) | uint64(h[1])<<8 | uint64(h[2])<<16 | uint64(h[3])<<24)
+}
