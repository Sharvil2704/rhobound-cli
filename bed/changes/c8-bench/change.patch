+			}
+			scores[d] += contrib
+		}
+	}
+	var topID [TopK]int32
+	var topScore [TopK]float64
+	topN := 0
+	for _, d := range touched {
+		s := scores[d]
+		scores[d] = 0
+		id := d + 1
+		pos := topN
+		for i := 0; i < topN; i++ {
+			if s > topScore[i] || (s == topScore[i] && id < topID[i]) {
+				pos = i
+				break
+			}
+		}
+		if pos >= TopK {
+			continue
+		}
+		if topN < TopK {
+			topN++
+		}
+		for i := topN - 1; i > pos; i-- {
+			topID[i] = topID[i-1]
+			topScore[i] = topScore[i-1]
+		}
+		topID[pos] = id
+		topScore[pos] = s
+	}
+	rb.touched = touched[:0]
