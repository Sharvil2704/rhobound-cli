--- /dev/null
+++ b/maze/app/internal/svc/rank/rank_diversify_test.go
@@ -0,0 +1,65 @@
+package rank
+
+import (
+	"sort"
+	"testing"
+)
+
+func TestDiversifyLambdaOneMatchesScoreOrder(t *testing.T) {
+	for _, seed := range []uint64{0, 1, 7, 12345} {
+		for _, k := range []int{0, 1, 10, 64} {
+			got := Diversify(seed, k, 1)
+			if len(got) != k {
+				t.Fatalf("seed %d k %d: len %d", seed, k, len(got))
+			}
+			// Reference: k highest Rerank scores, ties to lower index.
+			scores := make([]float64, cands)
+			for c := range cands {
+				f := Features(seed, c)
+				if len(f) != dims {
+					t.Fatalf("features len %d", len(f))
+				}
+				s := 0.0
+				for d := range dims {
+					s += weights[d] * f[d]
+				}
+				scores[c] = s
+			}
+			want := make([]int, cands)
+			for i := range want {
+				want[i] = i
+			}
+			sort.Slice(want, func(a, b int) bool {
+				if scores[want[a]] != scores[want[b]] {
+					return scores[want[a]] > scores[want[b]]
+				}
+				return want[a] < want[b]
+			})
+			want = want[:k]
+			for i := range want {
+				if got[i] != want[i] {
+					t.Fatalf("seed %d k %d: got %v want %v", seed, k, got, want)
+				}
+			}
+		}
+	}
+}
+
+func TestDiversifyClamp(t *testing.T) {
+	if got := Diversify(7, -1, 0.7); len(got) != 0 {
+		t.Fatalf("negative k: %v", got)
+	}
+	if got := Diversify(7, 100, 0.7); len(got) != 64 {
+		t.Fatalf("large k: len %d", len(got))
+	}
+}
+
+func TestFeaturesValues(t *testing.T) {
+	f := Features(7, 3)
+	for d := range dims {
+		want := float64((uint64(7)+uint64(3*32+d)*40503)%997) / 997
+		if f[d] != want {
+			t.Fatalf("d %d: got %v want %v", d, f[d], want)
+		}
+	}
+}
