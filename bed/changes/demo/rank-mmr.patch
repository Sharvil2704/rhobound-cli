+// Features returns candidate c's 32 features for request seed.
+func Features(seed uint64, c int) []float64 {
+	f := make([]float64, dims)
+	for d := range dims {
+		f[d] = float64((seed+uint64(c*dims+d)*40503)%997) / 997
+	}
+	return f
+}
+
+// Diversify chooses k of the 64 candidates greedily by maximal marginal relevance.
+func Diversify(seed uint64, k int, lambda float64) []int {
+	if k < 0 {
+		k = 0
+	}
+	if k > cands {
+		k = cands
+	}
+	if k == 0 {
+		return []int{}
+	}
+	feats := make([]float64, cands*dims)
+	for c := range cands {
+		for d := range dims {
+			feats[c*dims+d] = float64((seed+uint64(c*dims+d)*40503)%997) / 997
+		}
+	}
+	scores := make([]float64, cands)
+	for c := range cands {
+		s := 0.0
+		for d := range dims {
+			s += weights[d] * feats[c*dims+d]
+		}
+		scores[c] = s
+	}
+	maxScore := scores[0]
+	for _, s := range scores[1:] {
+		if s > maxScore {
+			maxScore = s
+		}
+	}
+	rel := make([]float64, cands)
+	if maxScore != 0 {
+		for c := range cands {
+			rel[c] = scores[c] / maxScore
+		}
+	}
+	norms := make([]float64, cands)
+	for c := range cands {
+		s := 0.0
+		for d := range dims {
+			v := feats[c*dims+d]
+			s += v * v
+		}
+		norms[c] = math.Sqrt(s)
+	}
+	chosen := make([]bool, cands)
+	out := make([]int, 0, k)
+	for len(out) < k {
+		best := -1
+		var bestVal float64
+		for c := range cands {
+			if chosen[c] {
+				continue
+			}
+			var v float64
+			if len(out) == 0 {
+				v = rel[c]
+			} else {
+				s := 0.0
+				for _, j := range out {
+					dot := 0.0
+					for d := range dims {
+						dot += feats[c*dims+d] * feats[j*dims+d]
+					}
+					den := norms[c] * norms[j]
+					var cos float64
+					if den != 0 {
+						cos = dot / den
+					}
+					if j == out[0] || cos > s {
+						s = cos
+					}
+				}
+				v = lambda*rel[c] - (1-lambda)*s
+			}
+			if best == -1 || v > bestVal {
+				best = c
+				bestVal = v
+			}
+		}
+		chosen[best] = true
+		out = append(out, best)
+	}
+	return out
+}
+
 func init() {
 	rt.Register("rank.rerank", func(r *rt.Req) error {
-		r.Out = fmt.Appendf(nil, "%v", Rerank(n.Add(1))[:10])
+		r.Out = fmt.Appendf(nil, "%v", Diversify(n.Add(1), 10, 0.7))
 		return nil
 	})
 }
diff --git a/maze/app/internal/svc/rank/rank_diversify_test.go b/maze/app/internal/svc/rank/rank_diversify_test.go
