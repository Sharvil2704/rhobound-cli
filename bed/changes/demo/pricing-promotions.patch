+// promoCombo is one promotion combination: at most one promotion per Group.
+// pct, free and fixed hold indexes into Promotions in table order; codes holds
+// the combination's codes, sorted.
+type promoCombo struct {
+	pct   []int
+	free  []int
+	fixed []int
+	codes []string
+}
+
+// promoCombos holds every combination, the empty one included. It is built
+// once and never mutated, so QuotePromo stays safe for concurrent use.
+var promoCombos = buildPromoCombos()
+
+func buildPromoCombos() []promoCombo {
+	var groups []string
+	byGroup := map[string][]int{}
+	for i, p := range Promotions {
+		if _, ok := byGroup[p.Group]; !ok {
+			groups = append(groups, p.Group)
+		}
+		byGroup[p.Group] = append(byGroup[p.Group], i)
+	}
+	opts := make([][]int, len(groups))
+	for gi, g := range groups {
+		opts[gi] = append([]int{-1}, byGroup[g]...)
+	}
+	var out []promoCombo
+	var cur []int
+	var rec func(gi int)
+	rec = func(gi int) {
+		if gi == len(opts) {
+			c := promoCombo{}
+			for _, pi := range cur {
+				switch Promotions[pi].Kind {
+				case "pct_line":
+					c.pct = append(c.pct, pi)
+				case "free_unit":
+					c.free = append(c.free, pi)
+				case "fixed_cart":
+					c.fixed = append(c.fixed, pi)
+				}
+				c.codes = append(c.codes, Promotions[pi].Code)
+			}
+			sort.Strings(c.codes)
+			out = append(out, c)
+			return
+		}
+		for _, o := range opts[gi] {
+			if o < 0 {
+				rec(gi + 1)
+				continue
+			}
+			cur = append(cur, o)
+			rec(gi + 1)
+			cur = cur[:len(cur)-1]
+		}
+	}
+	rec(0)
+	return out
+}
+
+// lessCodes reports whether the sorted code list a is lexicographically smaller
+// than b. Callers only compare lists of equal length.
+func lessCodes(a, b []string) bool {
+	for i := range a {
+		if a[i] != b[i] {
+			return a[i] < b[i]
+		}
+	}
+	return false
+}
+
+// QuotePromo returns the lowest total over all promotion combinations, the
+// empty one included, and the sorted codes of the combination that gives it.
+// Ties go to the combination with fewer promotions, then to the
+// lexicographically smallest sorted list of codes.
+func QuotePromo(lines []Line) (int, []string) {
+	base := make([]int, len(lines))
+	for i, l := range lines {
+		t := l.Cents * l.Qty
+		base[i] = (t*(1000-discountTable[min(l.Qty, 100)]) + 500) / 1000
+	}
+	work := make([]int, len(lines))
+	bestTotal := int(^uint(0) >> 1)
+	var bestCodes []string
+	for _, c := range promoCombos {
+		copy(work, base)
+		for _, pi := range c.pct {
+			p := Promotions[pi]
+			for i, l := range lines {
+				if l.Qty >= p.MinQty {
+					work[i] -= (work[i]*p.Value + 500) / 1000
+				}
+			}
+		}
+		for _, pi := range c.free {
+			p := Promotions[pi]
+			for i, l := range lines {
+				if l.Qty >= p.MinQty {
+					work[i] -= p.Value * l.Cents
+					if work[i] < 0 {
+						work[i] = 0
+					}
+				}
+			}
+		}
+		sub := 0
+		for _, w := range work {
+			sub += w
+		}
+		for _, pi := range c.fixed {
+			p := Promotions[pi]
+			if sub >= p.MinTotal {
+				sub -= p.Value
+				if sub < 0 {
+					sub = 0
+				}
+			}
+		}
+		if sub < bestTotal || (sub == bestTotal && (len(c.codes) < len(bestCodes) ||
+			(len(c.codes) == len(bestCodes) && lessCodes(c.codes, bestCodes)))) {
+			bestTotal = sub
+			bestCodes = c.codes
+		}
+	}
+	return bestTotal, append([]string(nil), bestCodes...)
+}
