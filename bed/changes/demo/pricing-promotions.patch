+// quoteJSON renders the pricing.quote response body for total and promos.
+func quoteJSON(total int, promos []string) []byte {
+	buf := fmt.Appendf(nil, `{"total":%d,"promos":[`, total)
+	for i, c := range promos {
+		if i > 0 {
+			buf = append(buf, ',')
+		}
+		buf = append(buf, '"')
+		buf = append(buf, c...)
+		buf = append(buf, '"')
+	}
+	return append(buf, ']', '}')
+}
