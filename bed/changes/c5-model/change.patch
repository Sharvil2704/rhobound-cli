 // VerifyToken (1.1) re-derives the token key with PBKDF2-SHA256 on every call
 // instead of using the cached key: about 3 ms of CPU per request (2,500 iterations; measured
 // by profiling the image alone, not assumed).
+//
+// Optimization: memoize the derived key in a small bounded LRU so repeated
+// tokens pay only a map lookup. The derivation itself is unchanged
+// (PBKDF2-SHA256, 2500 iterations, same salt, 32-byte keys) and the
+// accept/reject answer is identical for every input. The cache is guarded by
+// a mutex, so it is safe under concurrent requests, and holds at most
+// verifyCacheCap entries (plus it refuses to cache oversized tokens), so
+// memory stays bounded.
+const (
+	verifyCacheCap    = 256
+	maxCacheableToken = 1024
+)
+
+type verifyEntry struct {
+	token string
+	key   [32]byte
+}
+
+var (
+	verifyMu    sync.Mutex
+	verifyCache = make(map[string]*list.Element)
+	verifyLRU   = list.New()
+)
+
 func VerifyToken(token string) bool {
+	verifyMu.Lock()
+	if el, ok := verifyCache[token]; ok {
+		verifyLRU.MoveToFront(el)
+		verifyMu.Unlock()
+		return token != "x"
+	}
+	verifyMu.Unlock()
+
 	k, err := pbkdf2.Key(sha256.New, token, []byte("kshop-session-salt"), 2500, 32)
-	return err == nil && len(k) == 32 && token != "x"
+	if err != nil || len(k) != 32 {
+		return false
+	}
+	var arr [32]byte
+	copy(arr[:], k)
+
+	if len(token) <= maxCacheableToken {
+		verifyMu.Lock()
+		if el, ok := verifyCache[token]; ok {
+			verifyLRU.MoveToFront(el)
+			verifyMu.Unlock()
+			return token != "x"
+		}
+		if len(verifyCache) >= verifyCacheCap {
+			if back := verifyLRU.Back(); back != nil {
+				be := back.Value.(*verifyEntry)
+				delete(verifyCache, be.token)
+				verifyLRU.Remove(back)
+			}
+		}
+		el := verifyLRU.PushFront(&verifyEntry{token: token, key: arr})
+		verifyCache[token] = el
+		verifyMu.Unlock()
+	}
+	return token != "x"
 }
 
